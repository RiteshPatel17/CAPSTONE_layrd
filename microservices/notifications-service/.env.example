# ─────────────────────────────────────────────
# notifications-service — environment variables
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────

PORT=3003

# Must match the main app's INTERNAL_SERVICE_KEY (and every other
# microservice's) byte-for-byte.
INTERNAL_SERVICE_KEY=

# Resend — resend.com, API key from the dashboard. The sending domain
# (layrd.org) must be verified in Resend (Domains tab → add DNS records)
# before real customer emails will deliver — see CLAUDE.md for the
# exact DNS records needed.
RESEND_API_KEY=

# Real inbox that admin-facing alerts (new orders, event inquiries,
# contact form) go to.
ADMIN_EMAIL=info@layrd.org

# true  = admin-facing emails redirect to a safe test address (use during
#         development so test data never reaches the real inbox)
# false = admin-facing emails go to the real ADMIN_EMAIL (production)
NOTIFICATION_TEST_MODE=true

# Optional Gmail SMTP fallback (bypasses Resend entirely when both are
# set) — only needed if you want a zero-DNS-dependency way to test real
# email sending. Requires a Google Account App Password (needs 2-Step
# Verification enabled first): myaccount.google.com/apppasswords
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
