# ─────────────────────────────────────────────
# promo-code-service — environment variables
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────

# Same Supabase project as the main app
SUPABASE_URL=
SUPABASE_KEY=

# Must match the main app's INTERNAL_SERVICE_KEY (and every other
# microservice's) byte-for-byte.
INTERNAL_SERVICE_KEY=

PORT=3002
