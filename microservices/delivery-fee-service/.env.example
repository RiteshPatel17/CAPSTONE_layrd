# ─────────────────────────────────────────────
# delivery-fee-service — environment variables
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────

# OpenRouteService — openrouteservice.org, free tier API key
OPENROUTESERVICE_API_KEY=

# Store pickup address — origin point for distance calculations
PICKUP_ORIGIN_ADDRESS=336 Pinewind Close NE, Calgary, AB

# Must match the main app's INTERNAL_SERVICE_KEY (and every other
# microservice's) byte-for-byte.
INTERNAL_SERVICE_KEY=

PORT=3001
