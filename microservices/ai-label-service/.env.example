# ─────────────────────────────────────────────
# ai-label-service — environment variables
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────

PORT=3004

# Must match the main app's INTERNAL_SERVICE_KEY (and every other
# microservice's) byte-for-byte.
INTERNAL_SERVICE_KEY=

# Google AI Studio / Google Cloud — Gemini API key
GEMINI_API_KEY=

# Same Supabase project as the main app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used to notify customers by email once a label request is approved/needs changes
NOTIFICATIONS_SERVICE_URL=http://localhost:3003
